function handleAddCarRequest(ss, data) {
  return _withLock(function () {
    const brand = normalizeText(data.brand);
    const model = normalizeText(data.model);
    const year = normalizeText(data.year);

    if (!brand || !model) {
      return _json({ status: 'error', message: 'Марка и модель обязательны' });
    }
    if (year && !/^\d{4}$/.test(year)) {
      return _json({ status: 'error', message: 'Год должен быть в формате 2023' });
    }

    const brandKey = normKey(brand);
    const modelKey = normKey(model);
    const reqYear = parseInt(year, 10);

    const catalogSheet = ss.getSheetByName(CONFIG.SHEET_CATALOG);
    if (catalogSheet && isFinite(reqYear)) {
      const cat = catalogSheet.getDataRange().getValues();
      for (let i = 1; i < cat.length; i++) {
        if (normKey(cat[i][0]) !== brandKey || normKey(cat[i][1]) !== modelKey) continue;
        let y1 = parseInt(String(cat[i][2] || '').trim(), 10);
        let y2 = parseInt(String(cat[i][3] || '').trim(), 10);
        if (!isFinite(y1) && !isFinite(y2)) continue;
        if (!isFinite(y1)) y1 = y2;
        if (!isFinite(y2)) y2 = y1;
        if (y1 > y2) { const t = y1; y1 = y2; y2 = t; }
        if (reqYear >= y1 && reqYear <= y2) {
          return _json({ status: 'already_exists', message: 'Этот автомобиль уже есть в каталоге' });
        }
      }
    }

    const requestsSheet = ss.getSheetByName(CONFIG.SHEET_CAR_REQUESTS);
    if (!requestsSheet) {
      return _json({ status: 'error', message: 'Лист "Запросы на авто" не найден' });
    }
    const req = requestsSheet.getDataRange().getValues();
    for (let i = 1; i < req.length; i++) {
      const status = normalizeText(req[i][4]).toLowerCase();
      if (status === 'отклонено' || status === 'отклонён') continue;
      if (normKey(req[i][1]) === brandKey &&
          normKey(req[i][2]) === modelKey &&
          normKey(req[i][3]) === normKey(year)) {
        return _json({ status: 'already_requested', message: 'Запрос на этот автомобиль уже отправлен' });
      }
    }

    requestsSheet.appendRow([new Date(), brand, model, year, 'На рассмотрении']);
    return _json({ status: 'ok' });
  });
}

/* ==========================================================================
   14. ОПЛАТА
   ========================================================================== */

function handlePayOrder(ss, data) {
  return _withLock(function () {
    const sheet = ss.getSheetByName(CONFIG.SHEET_ORDERS);
    if (!sheet) return _json({ status: 'error', message: 'Лист "Заявки" не найден' });

    const targetId = normalizeText(data.orderId);
    if (!targetId) return _json({ status: 'error', message: 'orderId не указан' });

    const values = sheet.getDataRange().getValues();
    const rows = [];
    let unpriced = 0;
    let exactTotal = 0;

    for (let i = 1; i < values.length; i++) {
      if (normalizeText(values[i][1]) !== targetId) continue;
      const price = _num(values[i][8], 0);
      const exact = _num(values[i][9], 0);
      if (price <= 0 || exact <= 0) unpriced++;
      exactTotal += exact;
      rows.push({ row: i + 1, stage: getStageIndex(values[i][10]) });
    }

    if (!rows.length) return _json({ status: 'error', message: 'Заявка не найдена' });

    let eff = 0;
    rows.forEach(function (r) {
      if (r.stage === -2) eff = -2;
      else if (r.stage === -1 && eff !== -2) eff = -1;
      else if (eff >= 0 && r.stage > eff) eff = r.stage;
    });

    if (eff === -1) {
      return _json({ status: 'error', message: 'Заявка отменена — оплата невозможна' });
    }
    if (eff >= 3) {
      return _json({ status: 'error', message: 'Заявка уже оплачена' });
    }
    if (unpriced > 0) {
      return _json({
        status: 'error',
        message: 'Не все позиции рассчитаны менеджером (' + unpriced + ' из ' + rows.length + ')',
        partialPricing: true
      });
    }
    if (exactTotal <= 0) {
      return _json({ status: 'error', message: 'Не рассчитана точная сумма' });
    }

    const clientTotal = _num(data.exactTotal, 0);
    if (clientTotal > 0 && Math.abs(clientTotal - exactTotal) > 1) {
      return _json({
        status: 'error',
        message: 'Сумма изменилась. Обновите заявку и попробуйте снова.',
        exactTotal: exactTotal
      });
    }

    const now = new Date();
    rows.forEach(function (r) {
      sheet.getRange(r.row, 11).setValue('Оплачено');
      if (!sheet.getRange(r.row, 15).getValue()) {
        sheet.getRange(r.row, 15).setValue(now);
      }
    });

    return _json({
      status: 'ok',
      rowsUpdated: rows.length,
      exactTotal: exactTotal,
      paidAt: _fmtDate(now, true)
    });
  });
}

