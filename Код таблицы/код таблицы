function ping() {
  const ss = getSS();
  const names = [
    CONFIG.SHEET_PRODUCTS, CONFIG.SHEET_TC, CONFIG.SHEET_CATALOG,
    CONFIG.SHEET_ORDERS, CONFIG.SHEET_REQUESTS, CONFIG.SHEET_CAR_REQUESTS,
    CONFIG.SHEET_ARCHIVE_ORDERS, CONFIG.SHEET_ARCHIVE_REQUESTS
  ];
  const sheets = {};
  names.forEach(function (n) {
    const sh = ss.getSheetByName(n);
    sheets[n] = sh ? Math.max(0, sh.getLastRow() - 1) : null;
  });
  return _json({
    status: 'ok',
    version: CONFIG.VERSION,
    time: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM.yyyy HH:mm:ss'),
    spreadsheet: ss.getName(),
    rows: sheets
  });
}

function checkStructure() {
  const expect = {};
  expect[CONFIG.SHEET_PRODUCTS] = ['ID', 'Артикул', 'Название', 'Бренд', 'Цена', 'Категория', 'Описание', 'Марка', 'Модель', 'Год', 'Активен', 'Фото'];
  expect[CONFIG.SHEET_TC] = ['ID', 'Название', 'Город', 'Активна'];
  expect[CONFIG.SHEET_CATALOG] = ['Марка', 'Модель', 'Год_от', 'Год_до'];
  expect[CONFIG.SHEET_ORDERS] = ['Дата', 'ID', 'Клиент', 'Телефон', 'VIN', 'Товар', 'Артикул', 'Кол-во', 'Цена', 'Точная сумма', 'Статус', 'ТК', 'Адрес', 'Комментарий', 'Оплата получена'];
  expect[CONFIG.SHEET_REQUESTS] = ['Дата', 'ID', 'Клиент', 'Телефон', 'VIN', 'Авто', 'Товар', 'Артикул', 'Комментарий', 'Статус'];
  expect[CONFIG.SHEET_CAR_REQUESTS] = ['Дата', 'Марка', 'Модель', 'Год', 'Статус'];

  const ss = getSS();
  Logger.log('=== AutoPartsPilot ' + CONFIG.VERSION + ' · проверка структуры ===');
  Logger.log('Таблица: ' + ss.getName());

  Object.keys(expect).forEach(function (name) {
    const sh = ss.getSheetByName(name);
    if (!sh) { Logger.log('❌ НЕТ ЛИСТА: ' + name); return; }
    const cols = expect[name].length;
    const header = sh.getLastRow() >= 1 ? sh.getRange(1, 1, 1, cols).getValues()[0] : [];
    const empty = header.filter(function (h) { return !normalizeText(h); }).length;
    Logger.log('✅ ' + name + ' · строк данных: ' + Math.max(0, sh.getLastRow() - 1) +
      ' · нужно столбцов: ' + cols + ' · пустых заголовков: ' + empty);
  });

  const cat = ss.getSheetByName(CONFIG.SHEET_CATALOG);
  if (cat && cat.getLastRow() >= 2) {
    const d = cat.getRange(2, 1, cat.getLastRow() - 1, 4).getValues();
    let bad = 0;
    for (let i = 0; i < d.length; i++) {
      const y1 = parseInt(String(d[i][2] || '').trim(), 10);
      const y2 = parseInt(String(d[i][3] || '').trim(), 10);
      if (!normalizeText(d[i][0]) || !normalizeText(d[i][1]) || (!isFinite(y1) && !isFinite(y2))) {
        bad++;
        Logger.log('⚠️ Каталог, строка ' + (i + 2) + ': ' + d[i].join(' | '));
      }
    }
    Logger.log('Каталог: проблемных строк ' + bad);
  }

  Logger.log('=== Готово. Если все листы на месте — можно деплоить. ===');
}

