function onEdit(e) {
  if (!e || !e.range) return;

  const cache = CacheService.getScriptCache();
  if (cache.get('app_onedit_busy') === '1') return;

  try {
    cache.put('app_onedit_busy', '1', 5);
    const sheet = e.range.getSheet();
    const name = sheet.getName();

    if (name === CONFIG.SHEET_PRODUCTS) { _onEditProducts(e, sheet); return; }
    if (name === CONFIG.SHEET_CAR_REQUESTS) { _onEditCarRequests(e, sheet); return; }
    if (name === CONFIG.SHEET_ORDERS) { _onEditOrders(e, sheet); return; }
  } catch (err) {
    console.error('Ошибка в onEdit: ' + String(err));
  } finally {
    cache.remove('app_onedit_busy');
  }
}

function _onEditProducts(e, sheet) {
  const range = e.range;
  const row = range.getRow();
  const col = range.getColumn();
  if (row < 2) return;
  if (range.getNumRows() > 1 || range.getNumColumns() > 1) return;

  if (col >= 1 && col <= 12) {
    const idCell = sheet.getRange(row, 1);
    if (!normalizeText(idCell.getValue())) {
      const lastRow = sheet.getLastRow();
      let maxId = 0;
      if (lastRow >= 2) {
        const ids = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
        for (let i = 0; i < ids.length; i++) {
          const n = parseInt(String(ids[i][0] || '').trim(), 10);
          if (isFinite(n) && n > maxId) maxId = n;
        }
      }
      idCell.setValue(maxId + 1);
    }
  }

  if (col === 10) {
    const cell = sheet.getRange(row, 10);
    const value = normalizeText(cell.getValue());
    const isValid = value === '' ||
      value.toUpperCase() === 'ALL' ||
      /^\d{4}$/.test(value) ||
      /^\d{4}\s*[-–—]\s*\d{4}$/.test(value);

    if (!isValid) {
      cell.clearContent();
      cell.setBackground('#f4cccc');
      cell.setNote('Неверный формат года: "' + value + '"\n' +
        'Допустимо:\n' +
        '• пусто или ALL — универсальный товар\n' +
        '• 2021 — конкретный год\n' +
        '• 2020-2024 — диапазон');
      _toast('Год "' + value + '" неверный. Форматы: пусто / ALL / 2021 / 2020-2024', 'Товары: год');
    } else {
      cell.setBackground(null);
      cell.clearNote();
    }
  }

  if (col === 2) {
    const article = normalizeText(range.getValue());
    if (!article) return;
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    const articles = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
    for (let i = 0; i < articles.length; i++) {
      const rowNum = i + 2;
      if (rowNum === row) continue;
      if (normalizeText(articles[i][0]).toLowerCase() === article.toLowerCase()) {
        sheet.getRange(row, 2).setNote('Возможный дубликат артикула: строка ' + rowNum);
        _toast('Артикул "' + article + '" уже есть в строке ' + rowNum, 'Товары: дубликат');
        break;
      }
    }
  }
}

function _onEditCarRequests(e, sheet) {
  const range = e.range;
  const col = range.getColumn();
  const row = range.getRow();
  if (col !== 5 || row < 2) return;
  if (range.getNumRows() > 1 || range.getNumColumns() > 1) return;

  const status = normalizeText(range.getValue());
  if (CONFIG.APPROVE_STATUSES.indexOf(status.toLowerCase()) === -1) return;

  const brand = normalizeText(sheet.getRange(row, 2).getValue());
  const model = normalizeText(sheet.getRange(row, 3).getValue());
  const year = normalizeText(sheet.getRange(row, 4).getValue());

  if (!brand || !model) {
    _toast('Не заполнены марка/модель — в каталог не добавлено', 'Запросы на авто');
    return;
  }

  const result = _addCarToCatalog(e.source, brand, model, year);
  if (!result.ok) {
    sheet.getRange(row, 5).setNote(result.reason);
    _toast(result.reason, 'Запросы на авто');
    return;
  }

  sheet.getRange(row, 5).setNote(result.message + '\nОбработано: ' +
    Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM.yyyy HH:mm'));

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) { _toast(result.message, 'Каталог'); return; }

  const data = sheet.getRange(2, 1, lastRow - 1, 5).getValues();
  const brandKey = normKey(brand);
  const modelKey = normKey(model);
  const yearKey = normKey(year);

  const exactDuplicates = [];
  const similarRows = [];

  for (let i = 0; i < data.length; i++) {
    const rowNum = i + 2;
    if (rowNum === row) continue;

    const st = normalizeText(data[i][4]).toLowerCase();
    if (st === 'отклонено' || st === 'отклонён') continue;

    const bK = normKey(data[i][1]);
    const mK = normKey(data[i][2]);
    const yK = normKey(data[i][3]);
    if (!bK || !mK) continue;

    if (bK === brandKey && mK === modelKey && yK === yearKey) {
      exactDuplicates.push(rowNum);
      continue;
    }

    if (bK === brandKey && yK === yearKey && levenshteinDistance(mK, modelKey) <= 1) {
      similarRows.push(rowNum);
    }
  }

  similarRows.forEach(function (rn) {
    sheet.getRange(rn, 5).setNote('Похожий запрос обработан в строке ' + row +
      ' (' + brand + ' ' + model + ' ' + year + ').\nПроверьте вручную — это может быть ДРУГАЯ модель.');
  });

  if (CONFIG.DELETE_EXACT_DUPLICATES) {
    exactDuplicates.sort(function (a, b) { return b - a; }).forEach(function (rn) {
      sheet.deleteRow(rn);
    });
  } else {
    exactDuplicates.forEach(function (rn) {
      sheet.getRange(rn, 5).setValue(status);
      sheet.getRange(rn, 5).setNote('Точный дубликат строки ' + row + ' — обработан вместе с ней.');
    });
  }

  const dupInfo = exactDuplicates.length
    ? (' · дубликатов: ' + exactDuplicates.length + (CONFIG.DELETE_EXACT_DUPLICATES ? ' (удалены)' : ' (помечены)'))
    : '';
  _toast(result.message + dupInfo, 'Запросы на авто');
}

function _onEditOrders(e, sheet) {
  const range = e.range;
  const col = range.getColumn();
  const row = range.getRow();
  if (row < 2) return;
  if (range.getNumRows() > 1 || range.getNumColumns() > 1) return;
  if (col !== 9 && col !== 10 && col !== 11) return;

  const orderId = normalizeText(sheet.getRange(row, 2).getValue());
  if (!orderId) return;

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  const data = sheet.getRange(2, 1, lastRow - 1, CONFIG.ORDERS_COLS).getValues();

  const rows = [];
  let unpriced = 0;
  let exactTotal = 0;
  let eff = 0;

  for (let i = 0; i < data.length; i++) {
    if (normalizeText(data[i][1]) !== orderId) continue;
    const price = _num(data[i][8], 0);
    const exact = _num(data[i][9], 0);
    if (price <= 0 || exact <= 0) unpriced++;
    exactTotal += exact;
    const st = getStageIndex(data[i][10]);
    if (st === -2) eff = -2;
    else if (st === -1 && eff !== -2) eff = -1;
    else if (eff >= 0 && st > eff) eff = st;
    rows.push(i + 2);
  }

  if (!rows.length) return;

  if (col === 11 && eff === 2) {
    const cell = sheet.getRange(row, 11);
    if (unpriced > 0) {
      cell.setNote('ВНИМАНИЕ: не рассчитано позиций: ' + unpriced + ' из ' + rows.length +
        '.\nКлиент НЕ сможет оплатить, пока не заполнены столбцы I (цена) и J (точная сумма).');
      cell.setBackground('#fff2cc');
      _toast('Не рассчитано позиций: ' + unpriced + ' из ' + rows.length +
        ' — клиент пока не может оплатить', 'Заявка ' + orderId);
    } else {
      cell.clearNote();
      cell.setBackground(null);
    }
    return;
  }

  if ((col === 9 || col === 10) && CONFIG.AUTO_SET_PAYMENT_STATUS) {
    if (unpriced === 0 && exactTotal > 0 && eff >= 0 && eff <= 1) {
      rows.forEach(function (rn) {
        const cell = sheet.getRange(rn, 11);
        cell.setValue('Оплата');
        cell.clearNote();
        cell.setBackground(null);
      });
      _toast('Все позиции рассчитаны. Заявка ' + orderId +
        ' переведена в "Оплата": ' + exactTotal.toLocaleString('ru-RU') + ' ₽', 'Расчёт завершён');
    }
  }
}

