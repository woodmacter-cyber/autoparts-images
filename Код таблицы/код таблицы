   17. ДОБАВЛЕНИЕ АВТО В КАТАЛОГ
   ========================================================================== */

function _addCarToCatalog(ss, brand, model, year) {
  const sheet = ss.getSheetByName(CONFIG.SHEET_CATALOG);
  if (!sheet) return { ok: false, reason: 'Нет листа "Марки и Модели"' };

  const y = parseInt(String(year || '').trim(), 10);
  if (!isFinite(y) || y < CONFIG.YEAR_MIN || y > CONFIG.YEAR_MAX) {
    return { ok: false, reason: 'Год "' + year + '" не распознан — добавьте в каталог вручную' };
  }

  const brandKey = normKey(brand);
  const modelKey = normKey(model);
  const data = sheet.getDataRange().getValues();
  const sameCar = [];

  for (let i = 1; i < data.length; i++) {
    if (normKey(data[i][0]) !== brandKey || normKey(data[i][1]) !== modelKey) continue;
    let y1 = parseInt(String(data[i][2] || '').trim(), 10);
    let y2 = parseInt(String(data[i][3] || '').trim(), 10);
    sameCar.push({ row: i + 1, y1: y1, y2: y2 });
  }

  for (let k = 0; k < sameCar.length; k++) {
    const s = sameCar[k];
    if (isFinite(s.y1) && isFinite(s.y2) && y >= Math.min(s.y1, s.y2) && y <= Math.max(s.y1, s.y2)) {
      return { ok: true, action: 'exists', message: brand + ' ' + model + ' ' + y + ' уже в каталоге' };
    }
  }

  for (let k = 0; k < sameCar.length; k++) {
    const s = sameCar[k];
    if (!isFinite(s.y1) && !isFinite(s.y2)) {
      sheet.getRange(s.row, 3).setValue(y);
      sheet.getRange(s.row, 4).setValue(y);
      return { ok: true, action: 'filled', message: 'Годы заполнены: ' + brand + ' ' + model + ' ' + y };
    }
  }

  for (let k = 0; k < sameCar.length; k++) {
    const s = sameCar[k];
    let a = isFinite(s.y1) ? s.y1 : s.y2;
    let b = isFinite(s.y2) ? s.y2 : s.y1;
    if (a > b) { const t = a; a = b; b = t; }
    if (y === a - 1 || y === b + 1) {
      const newA = Math.min(a, y);
      const newB = Math.max(b, y);
      sheet.getRange(s.row, 3).setValue(newA);
      sheet.getRange(s.row, 4).setValue(newB);
      return {
        ok: true, action: 'merged',
        message: 'Диапазон расширен: ' + brand + ' ' + model + ' ' + newA + '-' + newB
      };
    }
  }

  sheet.appendRow([brand, model, y, y]);
  return { ok: true, action: 'added', message: 'Добавлено в каталог: ' + brand + ' ' + model + ' ' + y };
}

/* ==========================================================================
   18. onEdit
