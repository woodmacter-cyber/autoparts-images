/* ============================================================================
   AutoPartsPilot — Google Apps Script (бэкенд Google Sheets)
   Версия 2.2 · ШАГ 1: безопасность данных + частичный расчёт + защита оплаты + КАТАЛОГ
   ----------------------------------------------------------------------------
   ЧТО ИЗМЕНЕНО ОТНОСИТЕЛЬНО ПРЕДЫДУЩЕЙ ВЕРСИИ:
   1. Исправлены битые строки/регулярки (реальные переносы строк заменены на \n).
   2. УДАЛЕНО нечёткое удаление запросов на авто (Tank 300 ≠ Tank 500).
      Теперь обрабатываются только ТОЧНЫЕ дубликаты, и по умолчанию они
      не удаляются, а помечаются статусом (нулевая потеря данных).
   3. getOrders() возвращает partialPricing / unpricedRows / canPay.
   4. handlePayOrder() проверяет: все цены заполнены, сумма > 0, заявка не
      отменена и не оплачена повторно, сумма не изменилась.
   5. При одобрении авто диапазоны годов в каталоге расширяются (2020-2023 +
      2024 → 2020-2024), строки каталога никогда не удаляются.
   6. onEdit больше не вызывает getUi().alert (не работает в простом триггере):
      вместо этого toast + примечание к ячейке.
   7. Добавлен type=hide_order (архивация с сохранением статуса).
   8. Диагностика: ?action=ping и функция checkStructure().
   9. Защита от повторной отправки одной и той же заявки (идемпотентность).
   10. ДОБАВЛЕНО: getCarCatalog() для умного автокомплита в приложении.
   11. БЕЗОПАСНОСТЬ: getOrders/getRequests фильтруют выдачу по телефону клиента.
   ========================================================================== */

const CONFIG = {
  VERSION: '2.2',

  SHEET_PRODUCTS: 'Товары',
  SHEET_TC: 'ТК',
  SHEET_CATALOG: 'Марки и Модели',
  SHEET_ORDERS: 'Заявки',
  SHEET_REQUESTS: 'Запросы',
  SHEET_CAR_REQUESTS: 'Запросы на авто',
  SHEET_ARCHIVE_ORDERS: 'Архив заявок',
  SHEET_ARCHIVE_REQUESTS: 'Архив запросов',

  ORDERS_COLS: 15,   // A..O
  REQUESTS_COLS: 10, // A..J

  YEAR_MIN: 1950,
  YEAR_MAX: 2100,

  DELETE_EXACT_DUPLICATES: false,
  AUTO_SET_PAYMENT_STATUS: true,
  PAY_MAX_STAGE: 2,

  APPROVE_STATUSES: ['добавлено в каталог', 'добавлено', 'одобрено', 'одобрен', 'готово']
};

/* ==========================================================================
   1. БАЗОВЫЕ УТИЛИТЫ
   ========================================================================== */

function getSS() { return SpreadsheetApp.getActiveSpreadsheet(); }
function _sheet(name) { return getSS().getSheetByName(name); }

function _json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function _num(v, d) {
  if (d === undefined) d = 0;
  if (v === null || v === undefined || v === '') return d;
  if (typeof v === 'number') return isFinite(v) ? v : d;
  const clean = String(v).replace(/[^\d.,-]/g, '').replace(',', '.');
  const n = Number(clean);
  return isFinite(n) ? n : d;
}

function normalizeText(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/[\r\n\t]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function normKey(v) {
  return normalizeText(v).toLowerCase().replace(/[^a-zа-яё0-9]/g, '');
}

function _digits(v) {
  return String(v === null || v === undefined ? '' : v).replace(/\D/g, '');
}

function _fmtDate(v, withTime) {
  if (v instanceof Date) {
    const mask = withTime ? 'dd.MM.yyyy HH:mm' : 'dd.MM.yyyy';
    return Utilities.formatDate(v, Session.getScriptTimeZone(), mask);
  }
  return normalizeText(v);
}

function _isTrue(v) {
  if (v === true) return true;
  const s = String(v === null || v === undefined ? '' : v).trim().toLowerCase();
  return s === 'true' || s === '1' || s === 'да' || s === 'yes';
}

function _withLock(fn) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (e) {
    return _json({ status: 'error', message: 'Сервер занят, попробуйте ещё раз' });
  }
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

function _toast(message, title) {
  try {
    getSS().toast(message, title || 'AutoPartsPilot', 6);
  } catch (e) {
    console.log('TOAST: ' + message);
  }
}

/* ==========================================================================
   2. ТОЧКА ВХОДА GET (чтение)
   ========================================================================== */

function doGet(e) {
  try {
    const p = (e && e.parameter) ? e.parameter : {};
    const action = String(p.action || 'ping');

    if (action === 'getProducts') return getProducts();
    if (action === 'getTransportCompanies') return getTransportCompanies();
    // ПРАВКА ШАГ 1: передаём телефон в getOrders / getRequests
    if (action === 'getOrders') return getOrders(p.phone);
    if (action === 'getRequests') return getRequests(p.phone);
    if (action === 'getCarBrands') return getCarBrands();
    if (action === 'getCarCatalog') return getCarCatalog();
    if (action === 'ping') return ping();

    return _json({ status: 'error', message: 'Неизвестное действие: ' + action });
  } catch (err) {
    return _json({ status: 'error', error: 'Ошибка doGet: ' + String(err) });
  }
}

/* ==========================================================================
   3. ТОВАРЫ (A..L)
   ========================================================================== */

function getProducts() {
  try {
    const sheet = _sheet(CONFIG.SHEET_PRODUCTS);
    if (!sheet) return _json({ error: 'Лист "Товары" не найден.' });

    const data = sheet.getDataRange().getValues();
    if (data.length <= 1) return _json([]);

    const out = [];
    for (let i = 1; i < data.length; i++) {
      const r = data[i];
      if (!_isTrue(r[10])) continue;

      const year = normalizeText(r[9]);
      out.push({
        id: String(r[0] === null || r[0] === undefined ? '' : r[0]),
        article: normalizeText(r[1]),
        name: normalizeText(r[2]),
        brand: normalizeText(r[3]),
        price: _num(r[4]),
        category: normalizeText(r[5]),
        description: normalizeText(r[6]),
        make: normalizeText(r[7]),
        model: normalizeText(r[8]),
        year: year,
        isUniversal: (!year || year.toUpperCase() === 'ALL'),
        imageUrl: normalizeText(r[11])
      });
    }
    return _json(out);
  } catch (err) {
    return _json({ error: 'Ошибка при чтении товаров: ' + String(err) });
  }
}

/* ==========================================================================
   4. ТРАНСПОРТНЫЕ КОМПАНИИ
   ========================================================================== */

function getTransportCompanies() {
  try {
    const sheet = _sheet(CONFIG.SHEET_TC);
    if (!sheet) return _json({ error: 'Лист "ТК" не найден.' });

    const data = sheet.getDataRange().getValues();
    const out = [];
    for (let i = 1; i < data.length; i++) {
      const r = data[i];
      if (_isTrue(r[3]) && normalizeText(r[1])) {
        out.push({ id: String(r[0]), name: normalizeText(r[1]), city: normalizeText(r[2]) });
      }
    }
    return _json(out);
  } catch (err) {
    return _json({ error: 'Ошибка при чтении ТК: ' + String(err) });
  }
}

/* ==========================================================================
   5. МАРКИ И МОДЕЛИ
   ========================================================================== */

function getCarBrands() {
  try {
    const sheet = _sheet(CONFIG.SHEET_CATALOG);
    if (!sheet) return _json({});

    const data = sheet.getDataRange().getValues();
    const map = {};

    for (let i = 1; i < data.length; i++) {
      const brand = normalizeText(data[i][0]);
      const model = normalizeText(data[i][1]);
      if (!brand || !model) continue;

      let y1 = parseInt(String(data[i][2] || '').trim(), 10);
      let y2 = parseInt(String(data[i][3] || '').trim(), 10);

      if (!isFinite(y1) && !isFinite(y2)) continue;
      if (!isFinite(y1)) y1 = y2;
      if (!isFinite(y2)) y2 = y1;
      if (y1 > y2) { const t = y1; y1 = y2; y2 = t; }

      y1 = Math.max(CONFIG.YEAR_MIN, y1);
      y2 = Math.min(CONFIG.YEAR_MAX, y2);
      if (y1 > y2) continue;

      if (!map[brand]) map[brand] = {};
      if (!map[brand][model]) map[brand][model] = {};
      for (let y = y1; y <= y2; y++) map[brand][model][String(y)] = true;
    }

    const sorted = {};
    Object.keys(map).sort(function (a, b) { return a.localeCompare(b, 'en'); }).forEach(function (brand) {
      sorted[brand] = {};
      Object.keys(map[brand]).sort(function (a, b) { return a.localeCompare(b, 'en'); }).forEach(function (model) {
        sorted[brand][model] = Object.keys(map[brand][model])
          .sort(function (a, b) { return Number(b) - Number(a); });
      });
    });

    return _json(sorted);
  } catch (err) {
    console.error('getCarBrands: ' + String(err));
    return _json({});
  }
}

/* ==========================================================================
   5.1. ПОЛНЫЙ КАТАЛОГ АВТО (плоский массив)
   ========================================================================== */
function getCarCatalog() {
  try {
    const sheet = _sheet(CONFIG.SHEET_CATALOG);
    if (!sheet) return _json([]);

    const data = sheet.getDataRange().getValues();
    const catalog = [];

    for (let i = 1; i < data.length; i++) {
      const brand = normalizeText(data[i][0]);
      const model = normalizeText(data[i][1]);
      if (!brand || !model) continue;

      let y1 = parseInt(String(data[i][2] || '').trim(), 10);
      let y2 = parseInt(String(data[i][3] || '').trim(), 10);

      if (!isFinite(y1) && !isFinite(y2)) continue;
      if (!isFinite(y1)) y1 = y2;
      if (!isFinite(y2)) y2 = y1;
      if (y1 > y2) { const t = y1; y1 = y2; y2 = t; }

      y1 = Math.max(CONFIG.YEAR_MIN, y1);
      y2 = Math.min(CONFIG.YEAR_MAX, y2);
      if (y1 > y2) continue;

      catalog.push({
        make: brand,
        model: model,
        yearFrom: y1,
        yearTo: y2
      });
    }

    return _json(catalog);
  } catch (err) {
    console.error('getCarCatalog: ' + String(err));
    return _json([]);
  }
}

/* ==========================================================================
   6. ЗАЯВКИ (A..O) — ПРАВКА ШАГ 2
   ========================================================================== */

function getOrders(phone) {
  try {
    const sheet = _sheet(CONFIG.SHEET_ORDERS);
    if (!sheet) return _json([]);

    // ПРАВКА ШАГ 2а: ранний выход без телефона
    const myDigits = _digits(phone);
    if (!myDigits) return _json([]);

    const data = sheet.getDataRange().getValues();
    const map = {};

    for (let i = 1; i < data.length; i++) {
      const r = data[i];
      const orderId = normalizeText(r[1]);
      if (!orderId) continue;
      // ПРАВКА ШАГ 2б: фильтр по телефону
      if (_digits(r[3]) !== myDigits) continue;

      const qty = Math.max(1, _num(r[7], 1));
      const price = _num(r[8], 0);
      const exact = _num(r[9], 0);
      const statusRaw = normalizeText(r[10]) || 'Заявка отправлена';
      const stage = getStageIndex(statusRaw);
      const paidAt = _fmtDate(r[14], true);

      const item = {
        name: String(r[5] || ''),
        article: String(r[6] || ''),
        quantity: qty,
        price: price,
        exact: exact
      };

      if (map[orderId]) {
        const o = map[orderId];
        o.items.push(item);
        o.total += price * qty;
        o.exactTotal += exact;
        o.itemsCount += qty;
        o.rowsCount += 1;
        if (price <= 0 || exact <= 0) o.unpricedRows += 1;
        if (!o.paidAt && paidAt) o.paidAt = paidAt;

        if (stage === -2) { o._stage = -2; o.status = statusRaw; }
        else if (stage === -1 && o._stage !== -2) { o._stage = -1; o.status = statusRaw; }
        else if (o._stage >= 0 && stage > o._stage) { o._stage = stage; o.status = statusRaw; }
      } else {
        map[orderId] = {
          id: orderId,
          date: _fmtDate(r[0], false),
          customer: String(r[2] || ''),
          phone: String(r[3] || ''),
          vin: String(r[4] || ''),
          transportCompany: String(r[11] || ''),
          address: String(r[12] || ''),
          comment: String(r[13] || ''),
          paidAt: paidAt,
          total: price * qty,
          exactTotal: exact,
          itemsCount: qty,
          rowsCount: 1,
          unpricedRows: (price <= 0 || exact <= 0) ? 1 : 0,
          status: statusRaw,
          _stage: stage,
          items: [item],
          type: 'order'
        };
      }
    }

    const out = Object.keys(map).map(function (k) {
      const o = map[k];
      o.partialPricing = o.unpricedRows > 0;
      o.canPay = !o.partialPricing && o.exactTotal > 0 &&
                 o._stage >= 0 && o._stage <= CONFIG.PAY_MAX_STAGE;
      delete o._stage;
      return o;
    }).sort(function (a, b) {
      return String(b.id).localeCompare(String(a.id), undefined, { numeric: true });
    });

    return _json(out);
  } catch (err) {
    return _json({ error: 'Ошибка при чтении заявок: ' + String(err) });
  }
}

/* ==========================================================================
   7. ЗАПРОСЫ (A..J) — ПРАВКА ШАГ 3
   ========================================================================== */

function getRequests(phone) {
  try {
    const sheet = _sheet(CONFIG.SHEET_REQUESTS);
    if (!sheet) return _json([]);

    // ПРАВКА ШАГ 3а: ранний выход без телефона
    const myDigits = _digits(phone);
    if (!myDigits) return _json([]);

    const data = sheet.getDataRange().getValues();
    const map = {};

    for (let i = 1; i < data.length; i++) {
      const r = data[i];
      const reqId = normalizeText(r[1]);
      if (!reqId) continue;
      // ПРАВКА ШАГ 3б: фильтр по телефону
      if (_digits(r[3]) !== myDigits) continue;

      const statusRaw = normalizeText(r[9]) || 'Отправлен';
      const stage = getRequestStageIndex(statusRaw);
      const item = {
        name: String(r[6] || 'Запрос запчасти'),
        article: String(r[7] || ''),
        quantity: 1,
        price: 0
      };

      if (map[reqId]) {
        const o = map[reqId];
        o.items.push(item);
        o.itemsCount += 1;
        if (stage === -1 && o._stage !== 3) { o._stage = -1; o.status = statusRaw; }
        else if (o._stage >= 0 && stage > o._stage) { o._stage = stage; o.status = statusRaw; }
      } else {
        map[reqId] = {
          id: reqId,
          date: _fmtDate(r[0], false),
          customer: String(r[2] || ''),
          phone: String(r[3] || ''),
          vin: String(r[4] || ''),
          car: String(r[5] || ''),
          comment: String(r[8] || ''),
          total: 0,
          exactTotal: 0,
          itemsCount: 1,
          rowsCount: 1,
          unpricedRows: 0,
          partialPricing: false,
          status: statusRaw,
          _stage: stage,
          items: [item],
          type: 'request',
          transportCompany: '',
          address: ''
        };
      }
    }

    const out = Object.keys(map).map(function (k) {
      const o = map[k];
      delete o._stage;
      return o;
    }).sort(function (a, b) {
      return String(b.id).localeCompare(String(a.id), undefined, { numeric: true });
    });

    return _json(out);
  } catch (err) {
    return _json({ error: 'Ошибка при чтении запросов: ' + String(err) });
  }
}

/* ==========================================================================
   8. СТАТУСЫ
   ========================================================================== */

function getStageIndex(status) {
  if (!status) return 0;
  const s = String(status).toLowerCase().trim();
  if (s.indexOf('отменен') !== -1 || s.indexOf('отменено') !== -1) return -1;
  if (s.indexOf('удален клиентом') !== -1 || s.indexOf('удалено клиентом') !== -1) return -1;
  if (s.indexOf('ошибка отправки') !== -1) return -2;
  if (s.indexOf('получен') !== -1 || s.indexOf('выдан клиенту') !== -1) return 8;
  if (s.indexOf('готов к выдаче') !== -1 || s.indexOf('готово к выдаче') !== -1) return 7;
  if (s.indexOf('на складе в рф') !== -1 || s.indexOf('склад рф') !== -1 || s.indexOf('прибыл в рф') !== -1) return 6;
  if (s.indexOf('в пути') !== -1 || s.indexOf('таможн') !== -1 || s.indexOf('транзит') !== -1) return 5;
  if (s.indexOf('на складе в китае') !== -1 || s.indexOf('склад китая') !== -1) return 4;
  if (s.indexOf('оплачен') !== -1 || s.indexOf('оплатил') !== -1 || s.indexOf('закуп') !== -1 || s.indexOf('выкуп') !== -1) return 3;
  if (s.indexOf('оплата') !== -1 || s.indexOf('оплату') !== -1) return 2;
  if (s.indexOf('расчет') !== -1 || s.indexOf('расчит') !== -1 || s.indexOf('рассчит') !== -1) return 1;
  return 0;
}

function getRequestStageIndex(status) {
  if (!status) return 0;
  const s = String(status).toLowerCase().trim();
  if (s.indexOf('отменен') !== -1 || s.indexOf('отменено') !== -1) return -1;
  if (s.indexOf('отклонен') !== -1 || s.indexOf('отклонён') !== -1) return 3;
  if (s.indexOf('выполнен') !== -1 || s.indexOf('завершен') !== -1 || s.indexOf('завершён') !== -1) return 2;
  if (s.indexOf('в работе') !== -1 || s.indexOf('принят') !== -1) return 1;
  return 0;
}

/* ==========================================================================
   9. ТОЧКА ВХОДА POST (запись)
   ========================================================================== */

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return _json({ status: 'error', message: 'Нет тела запроса' });
    }
    const data = JSON.parse(e.postData.contents);
    const ss = getSS();
    const type = String(data.type || '');

    if (type === 'order') return handleOrder(ss, data);
    if (type === 'request') return handleRequest(ss, data);
    if (type === 'add_car_request') return handleAddCarRequest(ss, data);
    if (type === 'pay_order') return handlePayOrder(ss, data);
    if (type === 'cancel_order' || type === 'delete_order' ||
        type === 'complete_order' || type === 'hide_order') return handleArchive(ss, data);

    return _json({ status: 'error', message: 'Неизвестный type: ' + type });
  } catch (err) {
    return _json({ status: 'error', message: String(err) });
  }
}

/* ==========================================================================
   10. СЛУЖЕБНЫЕ ФУНКЦИИ ЗАПИСИ
   ========================================================================== */

function getFirstEmptyRow(sheet, idColIndex) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return 2;
  const ids = sheet.getRange(2, idColIndex, lastRow - 1, 1).getValues();
  for (let i = 0; i < ids.length; i++) {
    if (!ids[i][0] || String(ids[i][0]).trim() === '') return i + 2;
  }
  return lastRow + 1;
}

function _findRowsById(sheet, orderId) {
  const rows = [];
  if (!orderId) return rows;
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return rows;
  const ids = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
  for (let i = 0; i < ids.length; i++) {
    if (normalizeText(ids[i][0]) === orderId) rows.push(i + 2);
  }
  return rows;
}

function generateOrderId(sheetName, prefix) {
  const archiveName = (sheetName === CONFIG.SHEET_ORDERS)
    ? CONFIG.SHEET_ARCHIVE_ORDERS
    : CONFIG.SHEET_ARCHIVE_REQUESTS;

  let maxNum = 0;
  [sheetName, archiveName].forEach(function (name) {
    const sheet = _sheet(name);
    if (!sheet) return;
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    const ids = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
    for (let i = 0; i < ids.length; i++) {
      const numStr = String(ids[i][0] || '').trim().replace(/^[A-Za-z]+-/, '');
      const num = parseInt(numStr, 10);
      if (isFinite(num) && num > maxNum) maxNum = num;
    }
  });

  if (maxNum === 0) maxNum = Math.floor(Date.now() / 1000) % 100000;
  return prefix + (maxNum + 1);
}

/* ==========================================================================
   11. СОЗДАНИЕ ЗАЯВКИ
   ========================================================================== */

function handleOrder(ss, data) {
  return _withLock(function () {
    const sheet = ss.getSheetByName(CONFIG.SHEET_ORDERS);
    if (!sheet) return _json({ status: 'error', message: 'Лист "Заявки" не найден' });

    const items = Array.isArray(data.items) ? data.items : (data.items ? [data.items] : []);
    if (!items.length) return _json({ status: 'error', message: 'Пустой состав заявки' });

    const name = normalizeText(data.name || data.customer);
    const phone = normalizeText(data.phone);
    const vin = normalizeText(data.vin).toUpperCase();

    let orderId = normalizeText(data.orderId);

    if (orderId) {
      const existing = _findRowsById(sheet, orderId);
      if (existing.length) {
        const existingPhone = _digits(sheet.getRange(existing[0], 4).getValue());
        if (existingPhone === _digits(phone)) {
          return _json({ status: 'ok', orderId: orderId, duplicate: true });
        }
        orderId = '';
      }
    }
    if (!orderId) orderId = generateOrderId(CONFIG.SHEET_ORDERS, 'ORD-');

    const rows = items.map(function (it) {
      return [
        new Date(), orderId, name, phone, vin,
        normalizeText(it.name) || 'Запчасть',
        normalizeText(it.article) || 'Не указан',
        Math.max(1, _num(it.quantity, 1)),
        _num(it.price, 0),
        '',
        'Заявка отправлена',
        normalizeText(data.tcName) || 'Не выбрана',
        normalizeText(data.address),
        normalizeText(data.comment),
        ''
      ];
    });

    const startRow = getFirstEmptyRow(sheet, 2);
    sheet.getRange(startRow, 1, rows.length, CONFIG.ORDERS_COLS).setValues(rows);
    sheet.getRange(startRow, 4, rows.length, 2).setNumberFormat('@');

    return _json({ status: 'ok', orderId: orderId, rows: rows.length });
  });
}

/* ==========================================================================
   12. СОЗДАНИЕ ЗАПРОСА ЗАПЧАСТИ
   ========================================================================== */

function handleRequest(ss, data) {
  return _withLock(function () {
    const sheet = ss.getSheetByName(CONFIG.SHEET_REQUESTS);
    if (!sheet) return _json({ status: 'error', message: 'Лист "Запросы" не найден' });

    const items = Array.isArray(data.items) ? data.items : (data.items ? [data.items] : []);
    if (!items.length) return _json({ status: 'error', message: 'Пустой состав запроса' });

    const customer = normalizeText(data.customer || data.name) || 'Клиент';
    const phone = normalizeText(data.phone);
    const vin = normalizeText(data.vin).toUpperCase();
    const car = normalizeText(data.car);

    let reqId = normalizeText(data.orderId);
    if (reqId) {
      const existing = _findRowsById(sheet, reqId);
      if (existing.length) {
        const existingPhone = _digits(sheet.getRange(existing[0], 4).getValue());
        if (existingPhone === _digits(phone)) {
          return _json({ status: 'ok', orderId: reqId, duplicate: true });
        }
        reqId = '';
      }
    }
    if (!reqId) reqId = generateOrderId(CONFIG.SHEET_REQUESTS, 'REQ-');

    const rows = items.map(function (it) {
      return [
        new Date(), reqId, customer, phone, vin, car,
        normalizeText(it.name) || 'Запчасть',
        normalizeText(it.article),
        normalizeText(data.comment),
        'Отправлен'
      ];
    });

    const startRow = getFirstEmptyRow(sheet, 2);
    sheet.getRange(startRow, 1, rows.length, CONFIG.REQUESTS_COLS).setValues(rows);
    sheet.getRange(startRow, 4, rows.length, 2).setNumberFormat('@');

    return _json({ status: 'ok', orderId: reqId, rows: rows.length });
  });
}

