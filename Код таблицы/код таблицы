function handleArchive(ss, data) {
  return _withLock(function () {
    const orderId = normalizeText(data.orderId);
    if (!orderId) return _json({ status: 'error', message: 'orderId не указан' });

    const type = String(data.type || '');
    const keepStatus = (type === 'hide_order');

    const orderStatus = keepStatus ? null
      : (type === 'cancel_order' ? 'Отменено'
      : (type === 'delete_order' ? 'Удалено клиентом' : 'Получено клиентом'));

    const requestStatus = keepStatus ? null
      : (type === 'cancel_order' ? 'Отменено'
      : (type === 'delete_order' ? 'Удалено клиентом' : 'Выполнен'));

    const r1 = _archiveFromSheet(ss, CONFIG.SHEET_ORDERS, CONFIG.SHEET_ARCHIVE_ORDERS,
      orderId, orderStatus, CONFIG.ORDERS_COLS, 11);
    if (r1.moved) return _json({ status: 'ok', sheet: CONFIG.SHEET_ORDERS, rows: r1.count });

    const r2 = _archiveFromSheet(ss, CONFIG.SHEET_REQUESTS, CONFIG.SHEET_ARCHIVE_REQUESTS,
      orderId, requestStatus, CONFIG.REQUESTS_COLS, 10);
    if (r2.moved) return _json({ status: 'ok', sheet: CONFIG.SHEET_REQUESTS, rows: r2.count });

    return _json({ status: 'error', message: 'Заявка не найдена' });
  });
}

function _archiveFromSheet(ss, sourceName, archiveName, orderId, targetStatus, colCount, statusColNum) {
  const sheet = ss.getSheetByName(sourceName);
  if (!sheet) return { moved: false, count: 0 };

  let archive = ss.getSheetByName(archiveName);
  if (!archive) {
    archive = ss.insertSheet(archiveName);
    const headerRow = sheet.getLastRow() >= 1
      ? sheet.getRange(1, 1, 1, colCount).getValues()[0] : [];
    if (headerRow.length) archive.appendRow(headerRow);
  }

  const values = sheet.getDataRange().getValues();
  const rowsToArchive = [];
  const rowsToDelete = [];

  for (let i = 1; i < values.length; i++) {
    if (normalizeText(values[i][1]) !== orderId) continue;
    const row = values[i].slice(0, colCount);
    while (row.length < colCount) row.push('');
    if (targetStatus !== null) row[statusColNum - 1] = targetStatus;
    rowsToArchive.push(row);
    rowsToDelete.push(i + 1);
  }

  if (!rowsToArchive.length) return { moved: false, count: 0 };

  const startRow = archive.getLastRow() + 1;
  archive.getRange(startRow, 1, rowsToArchive.length, colCount).setValues(rowsToArchive);
  archive.getRange(startRow, 4, rowsToArchive.length, 2).setNumberFormat('@');

  rowsToDelete.sort(function (a, b) { return b - a; }).forEach(function (idx) {
    sheet.deleteRow(idx);
  });

  return { moved: true, count: rowsToArchive.length };
}

/* ==========================================================================
   16. НЕЧЁТКОЕ СРАВНЕНИЕ
   ========================================================================== */

function levenshteinDistance(a, b) {
  a = normKey(a);
  b = normKey(b);
  if (a === b) return 0;
  if (a.length === 0) return b.length;
  if (b.length === 0) return a.length;

  const matrix = [];
  for (let i = 0; i <= b.length; i++) matrix[i] = [i];
  for (let j = 0; j <= a.length; j++) matrix[0][j] = j;

  for (let i = 1; i <= b.length; i++) {
    for (let j = 1; j <= a.length; j++) {
      if (b.charAt(i - 1) === a.charAt(j - 1)) {
        matrix[i][j] = matrix[i - 1][j - 1];
      } else {
        matrix[i][j] = Math.min(
          matrix[i - 1][j - 1] + 1,
          matrix[i][j - 1] + 1,
          matrix[i - 1][j] + 1
        );
      }
    }
  }
  return matrix[b.length][a.length];
}

